<!DOCTYPE html>
<html>
  <head>
    <title>Dashboard · Fascy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <%= javascript_importmap_tags %>
    <style>
      :root { --fascy-accent:#ffb828; --fascy-dark:#1f2329; --fascy-side:#23272f; }
      body { background:#f4f6f9; }
      .dash-wrapper { display:flex; min-height:100vh; }
      .dash-sidebar {
        width:240px; flex-shrink:0; background:var(--fascy-side); color:#cfd3da;
        position:sticky; top:0; height:100vh; overflow-y:auto;
      }
      .dash-sidebar .brand {
        padding:18px 20px; font-weight:700; font-size:1.05rem; color:#fff;
        border-bottom:1px solid rgba(255,255,255,.06); letter-spacing:.5px;
      }
      .dash-sidebar .brand i { color:var(--fascy-accent); margin-right:8px; }
      .dash-sidebar .nav-section { padding:14px 20px 6px; font-size:.7rem; text-transform:uppercase; color:#7d8694; letter-spacing:.08em; }
      .dash-sidebar .nav-link {
        display:flex; align-items:center; gap:10px; padding:10px 20px; color:#cfd3da;
        border-left:3px solid transparent; font-size:.92rem;
      }
      .dash-sidebar .nav-link i { width:18px; text-align:center; color:#8c95a0; }
      .dash-sidebar .nav-link:hover { background:rgba(255,255,255,.04); color:#fff; }
      .dash-sidebar .nav-link.active {
        background:rgba(255,184,40,.08); color:#fff; border-left-color:var(--fascy-accent);
      }
      .dash-sidebar .nav-link.active i { color:var(--fascy-accent); }
      .dash-main { flex:1; min-width:0; }
      .dash-topbar {
        background:#fff; border-bottom:1px solid #e5e7eb;
        padding:12px 24px; display:flex; align-items:center; justify-content:space-between;
        position:sticky; top:0; z-index:10;
      }
      .dash-topbar .user-chip { font-size:.88rem; color:#475467; }
      .dash-topbar .user-chip i { color:var(--fascy-accent); margin-right:6px; }
      .dash-content { padding:24px; }
      .stat-card .stat-icon {
        width:48px; height:48px; border-radius:10px;
        display:flex; align-items:center; justify-content:center;
        font-size:1.25rem; color:#fff;
      }
      .btn-fascy { background:var(--fascy-accent); border-color:var(--fascy-accent); color:#1f2329; }
      .btn-fascy:hover, .btn-fascy:focus { background:#e9a516; border-color:#e9a516; color:#1f2329; }
      @media (max-width: 991.98px) {
        .dash-sidebar { position:fixed; left:-260px; transition:left .2s ease; z-index:1050; }
        .dash-sidebar.open { left:0; }
        .dash-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:1040; display:none; }
        .dash-backdrop.show { display:block; }
      }
    </style>
    <!-- CKEditor CDN loader with fallback + global initializer -->
    <script>
      (function() {
        var urls = [
          'https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js',
          'https://cdn.jsdelivr.net/npm/@ckeditor/ckeditor5-build-classic@39.0.1/build/ckeditor.js'
        ];

        function loadScript(src, onload, onerror) {
          var s = document.createElement('script');
          s.src = src;
          s.async = true;
          s.onload = onload;
          s.onerror = onerror;
          document.head.appendChild(s);
        }

        function initGlobalCKEditors() {
          if (window.ClassicEditor) {
            document.querySelectorAll('textarea.ckeditor').forEach(function(el) {
              if (!el.classList.contains('ck-editor-loaded')) {
                window.ClassicEditor.create(el)
                  .then(function(editor) { el.classList.add('ck-editor-loaded'); })
                  .catch(function(error) { console.error('CKEditor init error:', error); });
              }
            });
          }
        }

        var i = 0;
        function tryLoad() {
          if (i >= urls.length) {
            console.error('Failed to load CKEditor from all CDNs');
            return;
          }
          loadScript(urls[i], function() {
            setTimeout(initGlobalCKEditors, 50);
          }, function() {
            console.warn('CKEditor CDN failed, trying next:', urls[i]);
            i++; tryLoad();
          });
        }

        document.addEventListener('turbo:load', initGlobalCKEditors);
        document.addEventListener('DOMContentLoaded', function() { tryLoad(); });
      })();
    </script>
  </head>
  <body>
    <% current_path = request.path %>
    <% nav_items = [
         { label: 'Inicio',       icon: 'fa-gauge-high',  path: dashboard_root_path,            match: dashboard_root_path },
         { label: 'Productos',    icon: 'fa-box',         path: dashboard_productos_path,       match: '/dashboard/productos' },
         { label: 'Categorías',   icon: 'fa-layer-group', path: dashboard_categorias_path,      match: '/dashboard/categorias' },
         { label: 'Banners',      icon: 'fa-image',       path: dashboard_banners_path,         match: '/dashboard/banners' },
         { label: 'Sitio',        icon: 'fa-sliders',     path: edit_dashboard_site_setting_path, match: '/dashboard/site_setting' }
       ] %>

    <div class="dash-wrapper">
      <div class="dash-backdrop" id="dashBackdrop"></div>
      <aside class="dash-sidebar" id="dashSidebar">
        <div class="brand">
          <a href="<%= dashboard_root_path %>" class="text-decoration-none text-white">
            <i class="fas fa-bolt"></i>Fascy Admin
          </a>
        </div>
        <div class="nav-section">Navegación</div>
        <% nav_items.each do |item| %>
          <% active = item[:match] == dashboard_root_path ? current_path == dashboard_root_path : current_path.start_with?(item[:match]) %>
          <a class="nav-link <%= 'active' if active %>" href="<%= item[:path] %>">
            <i class="fas <%= item[:icon] %>"></i><%= item[:label] %>
          </a>
        <% end %>

        <div class="nav-section">Sitio</div>
        <a class="nav-link" href="<%= root_path %>" target="_blank" rel="noopener">
          <i class="fas fa-up-right-from-square"></i>Ver tienda
        </a>
        <% if admin_user_signed_in? %>
          <%= button_to destroy_admin_user_session_path, method: :delete,
                form: { class: 'd-block px-0 mx-0' },
                class: 'nav-link w-100 text-start bg-transparent border-0' do %>
            <i class="fas fa-right-from-bracket"></i>Salir
          <% end %>
        <% end %>
      </aside>

      <div class="dash-main">
        <div class="dash-topbar">
          <button class="btn btn-light d-lg-none" type="button" id="dashSidebarToggle" aria-label="Abrir menú">
            <i class="fas fa-bars"></i>
          </button>
          <div></div>
          <div class="user-chip">
            <% if admin_user_signed_in? %>
              <i class="fas fa-user-circle"></i><%= current_admin_user.email %>
            <% end %>
          </div>
        </div>

        <div class="dash-content">
          <% if notice %><div class="alert alert-success d-flex align-items-center gap-2"><i class="fas fa-circle-check"></i><div><%= notice %></div></div><% end %>
          <% if alert %><div class="alert alert-danger d-flex align-items-center gap-2"><i class="fas fa-circle-exclamation"></i><div><%= alert %></div></div><% end %>
          <%= yield %>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      (function() {
        function bind() {
          var btn = document.getElementById('dashSidebarToggle');
          var side = document.getElementById('dashSidebar');
          var back = document.getElementById('dashBackdrop');
          if (!btn || !side || !back) return;
          function open() { side.classList.add('open'); back.classList.add('show'); }
          function close() { side.classList.remove('open'); back.classList.remove('show'); }
          btn.addEventListener('click', open);
          back.addEventListener('click', close);
        }
        document.addEventListener('DOMContentLoaded', bind);
        document.addEventListener('turbo:load', bind);
      })();
    </script>
  </body>
</html>
