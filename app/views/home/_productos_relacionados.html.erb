<%# Productos relacionados — grid responsivo con "Ver más" %>
<% productos = local_assigns.fetch(:productos, (defined?(@producto) ? @producto.related_products : [])) %>
<% productos = productos.to_a %>
<% visible_inicial = 10 %>
<% hay_mas = productos.size > visible_inicial %>

<% if productos.present? %>
  <section class="related-products">
    <style>
      .related-products{padding:32px 0}
      .related-products__header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;gap:12px}
      .related-products__title{font-size:1.25rem;font-weight:700;margin:0;color:#1f2329}
      .related-products__divider{flex:1;height:2px;background:#ebebeb;margin:0 12px}
      .related-products__count{font-size:.85rem;color:#6b7280}
      .related-products__grid{
        display:grid;
        grid-template-columns:repeat(2, minmax(0, 1fr));
        gap:16px;
      }
      @media(min-width:576px){.related-products__grid{grid-template-columns:repeat(3, minmax(0, 1fr))}}
      @media(min-width:768px){.related-products__grid{grid-template-columns:repeat(4, minmax(0, 1fr))}}
      @media(min-width:1200px){.related-products__grid{grid-template-columns:repeat(5, minmax(0, 1fr))}}

      /* Items extra ocultos hasta que se exponda */
      [data-related-products] .rp-card--extra{display:none}
      [data-related-products][data-expanded="true"] .rp-card--extra{display:flex}

      .rp-card{
        position:relative;background:#fff;border:1px solid #ececec;border-radius:10px;
        overflow:hidden;transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        display:flex;flex-direction:column;height:100%;
      }
      .rp-card:hover{transform:translateY(-4px);box-shadow:0 10px 24px rgba(0,0,0,.08);border-color:#ddd}
      .rp-card__image{display:block;aspect-ratio:1/1;background:#fafafa;overflow:hidden;position:relative}
      .rp-card__image img{
        width:100%;height:100%;object-fit:contain;padding:10px;
        transition:transform .5s cubic-bezier(.2,.8,.2,1);
      }
      .rp-card:hover .rp-card__image img{transform:scale(1.06)}
      .rp-card__badge{
        position:absolute;top:8px;left:8px;background:#ffb828;color:#1f2329;
        font-size:.65rem;font-weight:700;padding:3px 8px;border-radius:4px;text-transform:uppercase;letter-spacing:.5px;
      }
      .rp-card__body{padding:12px;display:flex;flex-direction:column;gap:6px;flex:1}
      .rp-card__name{
        font-size:.92rem;font-weight:500;line-height:1.3;color:#1f2329;
        display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
        min-height:2.4em;text-decoration:none;
      }
      .rp-card__name:hover{color:#ffb828}
      .rp-card__meta{font-size:.75rem;color:#8b95a1;text-transform:uppercase;letter-spacing:.04em}
      .rp-card__cta{
        margin-top:auto;font-size:.8rem;font-weight:600;color:#1f2329;
        display:flex;align-items:center;gap:6px;opacity:0;transform:translateY(4px);
        transition:opacity .25s ease, transform .25s ease;
      }
      .rp-card:hover .rp-card__cta{opacity:1;transform:translateY(0)}
      .rp-card__cta i{transition:transform .2s ease}
      .rp-card:hover .rp-card__cta i{transform:translateX(3px)}

      .related-products__more{display:flex;justify-content:center;margin-top:20px}
      .related-products__more-btn{
        display:inline-flex;align-items:center;gap:8px;
        background:#fff;border:1.5px solid #ffb828;color:#1f2329;
        padding:10px 22px;border-radius:999px;font-weight:600;font-size:.9rem;
        cursor:pointer;transition:background .2s ease, color .2s ease;
      }
      .related-products__more-btn:hover{background:#ffb828}
      .related-products__more-btn i{transition:transform .25s ease}
      [data-related-products][data-expanded="true"] .related-products__more-btn i{transform:rotate(180deg)}
    </style>

    <div class="container" data-related-products data-expanded="false">
      <div class="related-products__header">
        <h3 class="related-products__title">Productos relacionados</h3>
        <div class="related-products__divider"></div>
        <span class="related-products__count">
          <span data-rp-shown><%= [productos.size, visible_inicial].min %></span> de <%= productos.size %>
        </span>
      </div>

      <div class="related-products__grid">
        <% productos.each_with_index do |producto, idx| %>
          <% portada = producto.imagen_portada || producto.portada %>
          <a href="<%= home_productos_detalle_path(producto) %>"
             class="rp-card text-decoration-none <%= 'rp-card--extra' if idx >= visible_inicial %>"
             data-turbo-frame="productos-detalle">
            <span class="rp-card__badge">Relacionado</span>
            <div class="rp-card__image">
              <% if portada.present? %>
                <%= image_tag portada, alt: producto.caracteristica, loading: 'lazy' %>
              <% else %>
                <img src="/images/products/default.jpg" alt="<%= producto.caracteristica %>" loading="lazy">
              <% end %>
            </div>
            <div class="rp-card__body">
              <% if producto.respond_to?(:marca) && producto.marca.present? %>
                <span class="rp-card__meta"><%= producto.marca.nombre %></span>
              <% end %>
              <span class="rp-card__name"><%= producto.caracteristica %></span>
              <span class="rp-card__cta">Ver detalle <i class="fas fa-arrow-right"></i></span>
            </div>
          </a>
        <% end %>
      </div>

      <% if hay_mas %>
        <div class="related-products__more">
          <button type="button" class="related-products__more-btn" data-rp-toggle
                  data-label-more="Ver <%= productos.size - visible_inicial %> más"
                  data-label-less="Ver menos">
            <span data-rp-toggle-label>Ver <%= productos.size - visible_inicial %> más</span>
            <i class="fas fa-chevron-down"></i>
          </button>
        </div>
      <% end %>
    </div>

    <script>
      (function(){
        function init(){
          document.querySelectorAll('[data-related-products]').forEach(function(root){
            if (root.__rpInit) return;
            root.__rpInit = true;
            var btn = root.querySelector('[data-rp-toggle]');
            var label = root.querySelector('[data-rp-toggle-label]');
            var shown = root.querySelector('[data-rp-shown]');
            var total = root.querySelectorAll('.rp-card').length;
            if (!btn) return;
            btn.addEventListener('click', function(){
              var expanded = root.getAttribute('data-expanded') === 'true';
              root.setAttribute('data-expanded', expanded ? 'false' : 'true');
              if (label) label.textContent = expanded ? btn.dataset.labelMore : btn.dataset.labelLess;
              if (shown) shown.textContent = expanded ? <%= visible_inicial %> : total;
              if (expanded){
                root.scrollIntoView({behavior:'smooth', block:'start'});
              }
            });
          });
        }
        document.addEventListener('DOMContentLoaded', init);
        document.addEventListener('turbo:load', init);
        document.addEventListener('turbo:frame-load', init);
      })();
    </script>
  </section>
<% end %>
