<% destacados_visibles = @productos_destacados.to_a.first(4) %>

<div class="block destacados-grid-block">
  <style>
    .destacados-grid-block{ padding:24px 0 }
    .destacados-grid-block .block-header{ margin-bottom:18px }
    .destacados-grid-block .destacados-grid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:14px;
    }
    @media(min-width:768px){.destacados-grid-block .destacados-grid{grid-template-columns:repeat(4, minmax(0, 1fr))}}

    .destacados-grid .product-card{
      height:100%;
      transition:transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease;
    }
    .destacados-grid .product-card:hover{
      transform:translateY(-4px);
      box-shadow:0 12px 24px rgba(0,0,0,.10);
    }
    .destacados-grid .product-card__image{
      background:#fff; padding:8px; border-radius:8px;
    }
    .destacados-grid .product-card__image .product-image__img{
      transition:transform .6s cubic-bezier(.2,.8,.2,1);
      will-change:transform;
    }
    .destacados-grid .product-card__image:hover .product-image__img,
    .destacados-grid .product-card__image:focus-within .product-image__img{
      transform:translateY(-4px) scale(1.03);
    }

    /* Botón Ver todos */
    .btn-ver-todos{
      display:inline-flex; align-items:center; gap:10px;
      background:#ffb828; color:#1f2329 !important;
      padding:11px 26px; border-radius:999px;
      font-weight:700; font-size:.95rem; text-decoration:none;
      border:2px solid #ffb828;
      box-shadow:0 6px 16px rgba(255,184,40,.35);
      transition:transform .25s ease, box-shadow .25s ease, background .25s ease, color .25s ease;
    }
    .btn-ver-todos:hover, .btn-ver-todos:focus{
      background:#fff; color:#1f2329 !important;
      transform:translateY(-2px);
      box-shadow:0 12px 26px rgba(255,184,40,.45);
    }
    .btn-ver-todos i{ transition:transform .25s ease }
    .btn-ver-todos:hover i{ transform:translateX(4px) }
    @media(max-width:575.98px){
      .btn-ver-todos{ padding:9px 20px; font-size:.88rem }
    }
  </style>

  <div class="container">
    <div class="block-header">
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <h3 class="block-header__title" style="margin-bottom:0;">Productos destacados</h3>
      </div>
      <div class="block-header__divider"></div>
      <%= link_to home_categoria_path('destacados'), class: 'btn-ver-todos' do %>
        Ver todos <i class="fas fa-arrow-right"></i>
      <% end %>
    </div>

    <div class="destacados-grid">
      <% destacados_visibles.each do |producto| %>
        <div class="product-card product-card--hidden-actions">
          <button class="product-card__quickview" type="button">
            <svg width="16px" height="16px"><use xlink:href="images/sprite.svg#quickview-16"></use></svg>
            <span class="fake-svg-icon"></span>
          </button>
          <div class="product-card__badges-list">
            <div class="product-card__badge product-card__badge--new">Destacado</div>
          </div>
          <div class="product-card__image product-image">
            <a href="<%= home_productos_detalle_path(producto) %>" class="product-image__body">
              <% portada = producto.imagen_portada || producto.portada %>
              <% if portada.present? %>
                <%= image_tag portada, class: "product-image__img", alt: producto.caracteristica, loading: "lazy" %>
              <% else %>
                <img class="product-image__img" src="images/products/default.jpg" alt="<%= producto.caracteristica %>" loading="lazy">
              <% end %>
            </a>
          </div>
          <div class="product-card__info">
            <div class="product-card__name">
              <a href="<%= home_productos_detalle_path(producto) %>"><%= producto.caracteristica %></a>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
