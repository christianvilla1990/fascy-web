<%
  # Meta + título
  if @subcategoria.present?
    content_for :title, @subcategoria.nombre
    content_for :meta_description, "Descubrí nuestra selección de productos de #{@subcategoria.nombre} en Fascy."
  elsif @categoria.present?
    content_for :title, @categoria.nombre
    content_for :meta_description, "Explorá todos los productos de la categoría #{@categoria.nombre} en Fascy."
  elsif params[:id] == 'destacados'
    content_for :title, "Productos destacados"
  elsif params[:id] == 'promo_mes'
    content_for :title, "Promociones del mes"
  elsif @search_term.present?
    content_for :title, "Búsqueda: #{@search_term}"
  end
%>

<% content_for :head do %>
  <%
    crumbs = [["Inicio", root_url]]
    if @subcategoria.present?
      if @subcategoria.respond_to?(:categoria) && @subcategoria.categoria.present?
        crumbs << [@subcategoria.categoria.nombre, home_categoria_url(@subcategoria.categoria)]
      end
      crumbs << [@subcategoria.nombre, home_categoria_url(@subcategoria)]
    elsif @categoria.present?
      crumbs << [@categoria.nombre, home_categoria_url(@categoria)]
    elsif params[:id] == 'destacados'
      crumbs << ["Productos destacados", home_categoria_url('destacados')]
    elsif params[:id] == 'promo_mes'
      crumbs << ["Promociones del mes", home_categoria_url('promo_mes')]
    end
  %>
  <%= json_ld_breadcrumbs(crumbs) if crumbs.size > 1 %>
<% end %>

<style>
  .cat-page{ padding:0 0 32px }
  .cat-header{ background:#fafafa; border-bottom:1px solid #ececec; padding:22px 0; margin-bottom:24px }
  .cat-header__crumbs{
    display:flex; flex-wrap:wrap; gap:6px; align-items:center;
    font-size:.85rem; color:#6b7280; margin-bottom:8px;
  }
  .cat-header__crumbs a{ color:#6b7280; text-decoration:none }
  .cat-header__crumbs a:hover{ color:#ffb828 }
  .cat-header__crumbs .sep{ color:#cfd3da }
  .cat-header__title{
    display:flex; flex-wrap:wrap; align-items:baseline; gap:14px; margin:0;
  }
  .cat-header__title h1{ font-size:1.7rem; font-weight:700; margin:0; color:#1f2329 }
  .cat-header__count{
    font-size:.85rem; color:#6b7280; background:#fff; border:1px solid #ececec;
    padding:4px 12px; border-radius:999px;
  }
  .cat-header__search-tag{
    display:inline-flex; align-items:center; gap:6px; font-size:.8rem;
    background:#fff7e0; color:#7a5500; border:1px solid #ffe18a;
    padding:3px 10px; border-radius:999px;
  }

  .cat-toolbar{
    display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between;
    margin-bottom:18px;
  }
  .cat-refine{
    flex:1; min-width:240px; max-width:480px; position:relative;
  }
  .cat-refine input{
    width:100%; padding:10px 14px 10px 40px; border-radius:999px;
    border:1.5px solid #d9dde3; background:#fff; font-size:.92rem;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  .cat-refine input:focus{
    outline:none; border-color:#ffb828; box-shadow:0 0 0 3px rgba(255,184,40,.15);
  }
  .cat-refine i{ position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#8b95a1 }
  .cat-sort{
    display:flex; align-items:center; gap:8px; font-size:.88rem; color:#6b7280;
  }
  .cat-sort select{
    border:1.5px solid #d9dde3; background:#fff; padding:8px 14px; border-radius:8px;
    font-size:.9rem; color:#1f2329; cursor:pointer;
  }
  .cat-sort select:focus{ outline:none; border-color:#ffb828 }

  .cat-chips{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px }
  .cat-chip{
    display:inline-flex; align-items:center; gap:6px;
    padding:6px 14px; border-radius:999px; background:#fff;
    border:1.5px solid #ececec; color:#1f2329; text-decoration:none;
    font-size:.85rem; font-weight:500;
    transition:border-color .2s ease, background .2s ease, color .2s ease;
  }
  .cat-chip:hover{ border-color:#ffb828; color:#1f2329 }
  .cat-chip.active{ background:#ffb828; border-color:#ffb828; color:#1f2329; font-weight:700 }

  .cat-grid{
    display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:14px;
  }
  @media(min-width:576px){ .cat-grid{ grid-template-columns:repeat(3, minmax(0, 1fr)) } }
  @media(min-width:768px){ .cat-grid{ grid-template-columns:repeat(4, minmax(0, 1fr)) } }

  .cat-card{
    background:#fff; border:1px solid #ececec; border-radius:10px; overflow:hidden;
    display:flex; flex-direction:column; height:100%; text-decoration:none;
    transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .cat-card:hover{ transform:translateY(-4px); box-shadow:0 10px 24px rgba(0,0,0,.08); border-color:#ddd }
  .cat-card__image{ aspect-ratio:1/1; background:#fafafa; overflow:hidden }
  .cat-card__image img{ width:100%; height:100%; object-fit:contain; padding:10px; transition:transform .5s ease }
  .cat-card:hover .cat-card__image img{ transform:scale(1.05) }
  .cat-card__body{ padding:12px; display:flex; flex-direction:column; gap:6px; flex:1 }
  .cat-card__name{
    font-size:.92rem; font-weight:500; line-height:1.3; color:#1f2329;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
    min-height:2.4em;
  }
  .cat-card:hover .cat-card__name{ color:#1f2329 }
  .cat-card__meta{ font-size:.72rem; color:#8b95a1; text-transform:uppercase; letter-spacing:.04em }
  .cat-card__cta{
    margin-top:auto; font-size:.78rem; font-weight:600; color:#1f2329;
    display:flex; align-items:center; gap:6px;
    opacity:0; transform:translateY(4px); transition:opacity .25s ease, transform .25s ease;
  }
  .cat-card:hover .cat-card__cta{ opacity:1; transform:translateY(0) }

  .cat-empty{
    text-align:center; padding:60px 20px; background:#fff;
    border:1px dashed #d9dde3; border-radius:14px;
  }
  .cat-empty__icon{ font-size:2.5rem; color:#cfd3da; margin-bottom:14px }
  .cat-empty__title{ font-size:1.1rem; font-weight:700; margin:0 0 6px; color:#1f2329 }
  .cat-empty__text{ color:#6b7280; margin:0 0 16px; font-size:.92rem }
  .cat-empty__actions{ display:flex; flex-wrap:wrap; gap:10px; justify-content:center }

  .cat-pagination{ display:flex; justify-content:center; margin-top:24px }

  @media(max-width:575.98px){
    .cat-header__title h1{ font-size:1.3rem }
    .cat-toolbar{ flex-direction:column; align-items:stretch; gap:10px }
    .cat-sort{ justify-content:space-between }
  }
</style>

<%= turbo_frame_tag "productos" do %>
  <div class="site__body cat-page">
    <%# Header %>
    <div class="cat-header">
      <div class="container">
        <ol class="cat-header__crumbs" style="list-style:none;padding:0;margin:0 0 8px;">
          <li><a href="/">Inicio</a></li>
          <% if @categoria.present? %>
            <li class="sep">/</li>
            <li><%= link_to @categoria.nombre, home_categoria_path(@categoria), data: { turbo_frame: 'productos' } %></li>
          <% elsif @subcategoria.present? && @subcategoria.respond_to?(:categoria) && @subcategoria.categoria.present? %>
            <li class="sep">/</li>
            <li><%= link_to @subcategoria.categoria.nombre, home_categoria_path(@subcategoria.categoria), data: { turbo_frame: 'productos' } %></li>
          <% end %>
          <li class="sep">/</li>
          <li><strong style="color:#1f2329"><%= @section_title %></strong></li>
        </ol>

        <div class="cat-header__title">
          <h1><%= @section_title %></h1>
          <% if @total_count.to_i > 0 %>
            <span class="cat-header__count">
              <%= @total_count %> <%= @total_count == 1 ? 'producto' : 'productos' %>
            </span>
          <% end %>
          <% if @search_term.present? %>
            <span class="cat-header__search-tag">
              <i class="fas fa-magnifying-glass"></i> "<%= @search_term %>"
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="container">
      <%# Toolbar: refine + sort %>
      <%= form_with url: request.path, method: :get, local: true, html: { class: 'cat-toolbar' } do %>
        <% if @search_term.present? %>
          <%= hidden_field_tag :search, @search_term %>
        <% end %>
        <% if params[:sub].present? %>
          <%= hidden_field_tag :sub, params[:sub] %>
        <% end %>

        <div class="cat-refine">
          <i class="fas fa-magnifying-glass"></i>
          <%= text_field_tag :q_refine, @q_refine, placeholder: 'Refinar búsqueda en esta sección...' %>
        </div>

        <div class="cat-sort">
          <span>Ordenar:</span>
          <%= select_tag :sort,
              options_for_select(
                [['Nombre (A-Z)', 'name_asc'], ['Nombre (Z-A)', 'name_desc'], ['Más recientes', 'recent']],
                @sort
              ),
              onchange: "this.form.requestSubmit()"
          %>
        </div>
      <% end %>

      <%# Chips de subcategorías %>
      <% if @subcategorias_filtro.present? && @subcategorias_filtro.any? %>
        <div class="cat-chips">
          <%= link_to home_categoria_path(@categoria), class: "cat-chip #{'active' unless @subcategoria_actual.present?}", data: { turbo_frame: 'productos' } do %>
            Todas
          <% end %>
          <% @subcategorias_filtro.each do |sub| %>
            <%= link_to home_categoria_path(@categoria, sub: sub.slug),
                class: "cat-chip #{'active' if @subcategoria_actual&.id == sub.id}",
                data: { turbo_frame: 'productos' } do %>
              <%= sub.nombre %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# Grid o empty state %>
      <% if @productos.any? %>
        <div class="cat-grid">
          <% @productos.each do |p| %>
            <%= link_to home_productos_detalle_path(p), class: 'cat-card', data: { turbo_frame: 'productos-detalle' } do %>
              <div class="cat-card__image">
                <% portada = p.imagen_portada %>
                <% if portada.present? %>
                  <%= image_tag portada.variant(resize_to_limit: [400, 400]).processed,
                                alt: p.caracteristica, loading: 'lazy' %>
                <% else %>
                  <img src="/images/products/default.jpg" alt="<%= p.caracteristica %>" loading="lazy">
                <% end %>
              </div>
              <div class="cat-card__body">
                <% if p.respond_to?(:marca) && p.marca.present? %>
                  <span class="cat-card__meta"><%= p.marca.nombre %></span>
                <% end %>
                <span class="cat-card__name"><%= p.caracteristica %></span>
                <span class="cat-card__cta">Ver detalle <i class="fas fa-arrow-right"></i></span>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="cat-pagination">
            <%== pagy_bootstrap_nav(@pagy)
                  .gsub('href="', 'data-turbo-frame="productos" href="') %>
          </div>
        <% end %>
      <% else %>
        <div class="cat-empty">
          <div class="cat-empty__icon"><i class="fas fa-box-open"></i></div>
          <h3 class="cat-empty__title">
            <% if @search_term.present? %>
              No encontramos productos para "<%= @search_term %>"
            <% elsif @q_refine.present? %>
              No hay productos que coincidan con "<%= @q_refine %>"
            <% else %>
              No hay productos en esta sección
            <% end %>
          </h3>
          <p class="cat-empty__text">
            Probá con otra palabra o explorá nuestras categorías.
          </p>
          <div class="cat-empty__actions">
            <%= link_to "← Volver al inicio", root_path, class: 'btn btn-outline-secondary btn-sm' %>
            <% if @q_refine.present? || @search_term.present? %>
              <%= link_to "Limpiar búsqueda", request.path,
                  class: 'btn btn-outline-secondary btn-sm',
                  data: { turbo_frame: 'productos' } %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= turbo_frame_tag "productos-detalle" do %>
      <% end %>
    </div>
  </div>
<% end %>
