<%= form_with(model: [:dashboard, banner], local: true, html: { multipart: true, class: 'banner-form' }) do |f| %>
  <% if banner.errors.any? %>
    <div class="alert alert-danger">
      <strong><i class="fas fa-circle-exclamation me-1"></i>Hay errores en el formulario:</strong>
      <ul class="mb-0">
        <% banner.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-12 col-lg-7">
      <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white"><strong>Información</strong></div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :titulo, 'Título', class: 'form-label' %>
            <%= f.text_field :titulo, class: 'form-control', placeholder: 'Ej: Promo de invierno' %>
          </div>
          <div class="mb-3">
            <%= f.label :descripcion, 'Descripción', class: 'form-label' %>
            <%= f.text_area :descripcion, class: 'form-control', rows: 3 %>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <%= f.label :tipo, 'Tipo', class: 'form-label' %>
              <%= f.select :tipo, [['Principal', 'principal'], ['Secundario', 'secundario']], {}, class: 'form-select' %>
            </div>
            <div class="col-md-6 mb-3">
              <%= f.label :link, 'Link', class: 'form-label' %>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-link text-muted"></i></span>
                <%= f.text_field :link, class: 'form-control', placeholder: 'https://...' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white"><strong>Imágenes</strong></div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :imagen, 'Imagen para escritorio', class: 'form-label' %>
            <% if banner.imagen.attached? %>
              <div class="mb-2"><%= image_tag banner.imagen.variant(resize_to_limit: [320, 160]), class: 'img-thumbnail' %></div>
            <% end %>
            <%= f.file_field :imagen, class: 'form-control', accept: 'image/*' %>
            <small class="form-text text-muted d-block mt-1">Recomendado: 1600×500 px (principal) o 1600×650 px (secundario).</small>
          </div>
          <div class="mb-3">
            <%= f.label :imagen_mobile, 'Imagen para móvil', class: 'form-label' %>
            <% if banner.imagen_mobile.attached? %>
              <div class="mb-2"><%= image_tag banner.imagen_mobile.variant(resize_to_limit: [180, 240]), class: 'img-thumbnail' %></div>
            <% end %>
            <%= f.file_field :imagen_mobile, class: 'form-control', accept: 'image/*' %>
            <small class="form-text text-muted d-block mt-1">Recomendado: 600×800 px. Si no la cargás, se recortará el centro de la imagen de escritorio.</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-2">
    <%= f.submit (banner.persisted? ? 'Guardar cambios' : 'Crear banner'), class: 'btn btn-fascy' %>
    <%= link_to 'Cancelar', dashboard_banners_path, class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
