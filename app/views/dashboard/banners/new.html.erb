<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 m-0"><i class="fas fa-image text-muted me-2"></i>Nuevo banner</h1>
    <p class="text-muted small mb-0">Cargá un banner principal o secundario.</p>
  </div>
  <%= link_to dashboard_banners_path, class: 'btn btn-outline-secondary d-flex align-items-center gap-2' do %>
    <i class="fas fa-arrow-left"></i> Volver
  <% end %>
</div>

<%= render 'form', banner: @banner %>
