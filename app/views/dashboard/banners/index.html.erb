<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 m-0"><i class="fas fa-image text-muted me-2"></i>Banners</h1>
    <p class="text-muted small mb-0">Banners principales y secundarios del sitio.</p>
  </div>
  <%= link_to new_dashboard_banner_path, class: 'btn btn-fascy d-flex align-items-center gap-2' do %>
    <i class="fas fa-plus"></i> Nuevo banner
  <% end %>
</div>

<div class="card shadow-sm border-0 mb-3">
  <div class="card-body">
    <%= form_with url: dashboard_banners_path, method: :get, local: true, html: { class: "row g-2 align-items-end" } do %>
      <div class="col-md-5">
        <label class="form-label small text-muted">Buscar por título</label>
        <div class="input-group">
          <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
          <input type="text" name="q" value="<%= @q %>" class="form-control" placeholder="Título del banner">
        </div>
      </div>
      <div class="col-md-3">
        <label class="form-label small text-muted">Tipo</label>
        <select name="tipo" class="form-select">
          <option value="">Todos</option>
          <option value="principal" <%= 'selected' if @tipo == 'principal' %>>Principal</option>
          <option value="secundario" <%= 'selected' if @tipo == 'secundario' %>>Secundario</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted">Por página</label>
        <select name="per_page" class="form-select">
          <% [10, 20, 50, 100].each do |n| %>
            <option value="<%= n %>" <%= 'selected' if params[:per_page].to_i == n %>><%= n %></option>
          <% end %>
        </select>
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit"><i class="fas fa-filter me-1"></i>Aplicar</button>
      </div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th style="width:140px">Imagen</th>
          <th>Título</th>
          <th>Tipo</th>
          <th>Link</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @banners.any? %>
          <% @banners.each do |banner| %>
            <tr>
              <td>
                <% if banner.imagen.attached? %>
                  <%= image_tag banner.imagen.variant(resize_to_limit: [120, 60]), class: "img-thumbnail" %>
                <% else %>
                  <span class="text-muted"><i class="fas fa-image"></i></span>
                <% end %>
              </td>
              <td class="fw-semibold"><%= banner.titulo %></td>
              <td>
                <% case banner.tipo
                   when 'principal' %>
                  <span class="badge bg-primary-subtle text-primary">Principal</span>
                <% when 'secundario' %>
                  <span class="badge bg-info-subtle text-info">Secundario</span>
                <% else %>
                  <span class="badge bg-secondary-subtle text-secondary"><%= banner.tipo %></span>
                <% end %>
              </td>
              <td class="text-muted small text-truncate" style="max-width:280px"><%= banner.link %></td>
              <td class="text-end">
                <%= link_to edit_dashboard_banner_path(banner), class: 'btn btn-sm btn-outline-primary', title: 'Editar' do %>
                  <i class="fas fa-pen"></i>
                <% end %>
                <%= button_to dashboard_banner_path(banner), method: :delete, data: { turbo_confirm: '¿Eliminar este banner?' }, form: { class: 'd-inline' }, class: 'btn btn-sm btn-outline-danger', title: 'Eliminar' do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="5" class="text-center text-muted py-4">No hay banners.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy && @pagy.pages > 1 %>
  <div class="d-flex justify-content-center my-3">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
