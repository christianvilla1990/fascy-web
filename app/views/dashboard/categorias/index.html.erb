<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 m-0"><i class="fas fa-layer-group text-muted me-2"></i>Categorías</h1>
    <p class="text-muted small mb-0">Editá nombre, principal e imagen de cada categoría.</p>
  </div>
</div>

<div class="card shadow-sm border-0 mb-3">
  <div class="card-body">
    <%= form_with url: dashboard_categorias_path, method: :get, local: true, html: { class: "row g-2 align-items-end" } do %>
      <div class="col-md-8">
        <label class="form-label small text-muted">Buscar por nombre</label>
        <div class="input-group">
          <span class="input-group-text bg-white"><i class="fas fa-magnifying-glass text-muted"></i></span>
          <input type="text" name="q" value="<%= @q %>" class="form-control" placeholder="Nombre de la categoría">
        </div>
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted">Por página</label>
        <select name="per_page" class="form-select">
          <% [10, 20, 50, 100].each do |n| %>
            <option value="<%= n %>" <%= 'selected' if params[:per_page].to_i == n %>><%= n %></option>
          <% end %>
        </select>
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-primary w-100" type="submit"><i class="fas fa-filter me-1"></i>Aplicar</button>
      </div>
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th style="width:90px">Imagen</th>
          <th>Nombre</th>
          <th class="text-center">Principal</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @categorias.any? %>
          <% @categorias.each do |categoria| %>
            <tr>
              <td>
                <% if categoria.imagen.attached? %>
                  <%= image_tag(categoria.imagen.variant(resize_to_limit: [60,60]), class: 'rounded') rescue image_tag(categoria.imagen, style: 'max-width:60px') %>
                <% else %>
                  <span class="text-muted"><i class="fas fa-image"></i></span>
                <% end %>
              </td>
              <td class="fw-semibold"><%= categoria.nombre %></td>
              <td class="text-center">
                <% if categoria.principal? %>
                  <span class="badge bg-success-subtle text-success"><i class="fas fa-check me-1"></i>Sí</span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="text-end">
                <%= link_to edit_dashboard_categoria_path(categoria), class: 'btn btn-sm btn-outline-primary', title: 'Editar' do %>
                  <i class="fas fa-pen"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="text-center text-muted py-4">No hay categorías.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy && @pagy.pages > 1 %>
  <div class="d-flex justify-content-center my-3">
    <%== pagy_bootstrap_nav(@pagy) %>
  </div>
<% end %>
