<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 m-0"><i class="fas fa-box text-muted me-2"></i>Editar producto</h1>
    <p class="text-muted small mb-0">
      <%= @producto.caracteristica %>
      <span class="text-secondary">·</span>
      ID <%= @producto.id %>
      <% if @producto.sku.present? %><span class="text-secondary">·</span> SKU <%= @producto.sku %><% end %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to [:dashboard, @producto], class: 'btn btn-outline-secondary d-flex align-items-center gap-2' do %>
      <i class="fas fa-eye"></i> Ver
    <% end %>
    <%= link_to dashboard_productos_path, class: 'btn btn-outline-secondary d-flex align-items-center gap-2' do %>
      <i class="fas fa-arrow-left"></i> Volver
    <% end %>
  </div>
</div>

<%= render "form" %>
