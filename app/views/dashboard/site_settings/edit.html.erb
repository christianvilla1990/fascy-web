<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 m-0"><i class="fas fa-image text-muted me-2"></i>Configuración del sitio</h1>
    <p class="text-muted small mb-0">Administrá el logo y el nombre que ven tus visitantes.</p>
  </div>
</div>

<%= form_with model: @site_setting, url: dashboard_site_setting_path, method: :patch, local: true, html: { multipart: true } do |f| %>
  <% if @site_setting.errors.any? %>
    <div class="alert alert-danger">
      <strong><i class="fas fa-circle-exclamation me-1"></i>Hay errores en el formulario:</strong>
      <ul class="mb-0">
        <% @site_setting.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-12 col-lg-6">
      <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white"><strong>Identidad</strong></div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :nombre_sitio, "Nombre del sitio", class: "form-label" %>
            <%= f.text_field :nombre_sitio, class: "form-control", placeholder: "Ej: Fascy" %>
            <small class="form-text text-muted">Se usa en el atributo <code>alt</code> del logo y para SEO.</small>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white"><strong>Logo escritorio</strong></div>
        <div class="card-body">
          <% if @site_setting.logo.attached? %>
            <div class="mb-2 p-3 rounded" style="background:#f4f6f9;display:inline-block">
              <%= image_tag @site_setting.logo.variant(resize_to_limit: [320, 120]), style: "max-height:120px" %>
            </div>
          <% end %>
          <%= f.file_field :logo, class: "form-control", accept: "image/*" %>
          <small class="form-text text-muted d-block mt-1">Recomendado: PNG o WEBP, hasta ~400×120 px. Fondo transparente si es posible.</small>
        </div>
      </div>

      <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-white"><strong>Logo móvil <span class="text-muted small">(opcional)</span></strong></div>
        <div class="card-body">
          <% if @site_setting.logo_mobile.attached? %>
            <div class="mb-2 p-3 rounded" style="background:#f4f6f9;display:inline-block">
              <%= image_tag @site_setting.logo_mobile.variant(resize_to_limit: [200, 100]), style: "max-height:100px" %>
            </div>
          <% end %>
          <%= f.file_field :logo_mobile, class: "form-control", accept: "image/*" %>
          <small class="form-text text-muted d-block mt-1">Si lo dejás vacío, en mobile se usa el logo de escritorio.</small>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-2">
    <%= f.submit "Guardar cambios", class: "btn btn-fascy" %>
    <%= link_to "Cancelar", dashboard_root_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
